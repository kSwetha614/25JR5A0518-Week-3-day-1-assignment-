# Train Test Split
from sklearn.model_selection import train_test_split

X_train, X_test, y_train, y_test = train_test_split(
    X,
    y,
    test_size=0.20,
    random_state=42
)

print("X_train Shape:", X_train.shape)
print("X_test Shape:", X_test.shape)

print("y_train Shape:", y_train.shape)
print("y_test Shape:", y_test.shape)
X_train Shape: (9, 3)
X_test Shape: (3, 3)
y_train Shape: (9,)
y_test Shape: (3,)
# Train Model

from sklearn.linear_model import LinearRegression

model = LinearRegression()

model.fit(X_train, y_train)

print("Coefficients (Slope):")
print(model.coef_)

print("\nIntercept:")
print(model.intercept_)
Coefficients (Slope):
[ 3.45487968  1.34491979 -2.40274064]

Intercept:
-48.100601604278054
# Predictions

new_data = pd.DataFrame({
    "Study_Hours":[5,8,12],
    "Attendance":[80,90,95],
    "Assignments":[5,8,10]
})

predictions = model.predict(new_data)

for i, pred in enumerate(predictions):
    print(f"Student {i+1} Predicted Marks: {pred:.2f}")
Student 1 Predicted Marks: 64.75
Student 2 Predicted Marks: 81.36
Student 3 Predicted Marks: 97.10
# Actual vs Predicted

y_pred = model.predict(X_test)

comparison = pd.DataFrame({
    "Actual Marks": y_test.values,
    "Predicted Marks": y_pred
})

comparison["Difference"] = abs(
    comparison["Actual Marks"] -
    comparison["Predicted Marks"]
)

print(comparison)

highest_error = comparison["Difference"].max()

print("\nHighest Prediction Error:", highest_error)
   Actual Marks  Predicted Marks  Difference
0            92        92.011029    0.011029
1            88        88.269051    0.269051
2            35        31.243984    3.756016

Highest Prediction Error: 3.7560160427807574
# Model Evaluation

from sklearn.metrics import mean_absolute_error
from sklearn.metrics import r2_score

mae = mean_absolute_error(y_test, y_pred)

r2 = r2_score(y_test, y_pred)

print("MAE:", mae)
print("R² Score:", r2)
